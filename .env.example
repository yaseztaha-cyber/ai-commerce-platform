# --- Database ---
DATABASE_URL="postgresql://aicommerce:aicommerce_dev@localhost:5432/aicommerce"
POSTGRES_USER=aicommerce
POSTGRES_PASSWORD=aicommerce_dev
POSTGRES_DB=aicommerce
POSTGRES_PORT=5432

# --- Redis (optional; queue falls back to in-memory) ---
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-64-hex-chars-min-32"
SESSION_COOKIE_NAME="ac_session"
SESSION_TTL_HOURS=168

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV=development
# Optional: shown on login/register as a dev hint. NEVER set in production.
DEMO_LOGIN_HINT=

# --- LLM (rulebased | openrouter | opencode | composite | openai-legacy) ---
# Default "rulebased" = deterministic offline engine, no network, no cost.
LLM_PROVIDER="rulebased"
# Primary model (OpenRouter slug). Free catalog changes often — see docs/MODELS.md
# for how to list current free tool-capable models.
LLM_MODEL="z-ai/glm-5.2:free"
# Second model tried on the primary gateway before switching provider.
LLM_FALLBACK_MODEL="google/gemma-4-31b-it:free"
# Optional per-task overrides (empty = use LLM_MODEL). Tasks: agent/simple/extract/complex/rag.
LLM_MODEL_AGENT=""
LLM_MODEL_SIMPLE=""
LLM_MODEL_EXTRACT=""
LLM_MODEL_COMPLEX=""
LLM_MODEL_RAG=""
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_MAX_TOOL_CALLS=8
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=1

# --- OpenRouter gateway (https://openrouter.ai). Key stays server-side ONLY. ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- OpenCode Zen fallback gateway (https://opencode.ai/zen). Key stays server-side ONLY. ---
OPENCODE_API_KEY=
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_MODEL="deepseek-v4-flash-free"

# --- Embeddings (openai | local). "local" = deterministic hash embeddings, no API key needed. ---
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="local-hash-1536"
EMBEDDING_DIM=1536
OPENAI_API_KEY_FOR_EMBEDDINGS=""

# --- Voice transcription (leak 1B). Empty key = instant text fallback. ---
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL="https://api.openai.com/v1"
TRANSCRIBE_MODEL="whisper-1"
TRANSCRIBE_LANGUAGE="ar"
TRANSCRIBE_TIMEOUT_MS=30000
TRANSCRIBE_MAX_BYTES=26214400

# --- Inbound sight (leak 2B). Empty key = instant text fallback. Output is a candidate only. ---
VISION_API_KEY=
VISION_BASE_URL="https://api.openai.com/v1"
VISION_MODEL="gpt-4o-mini"
VISION_TIMEOUT_MS=30000
VISION_MAX_BYTES=10485760
VISION_MIN_CONFIDENCE=0.7
VISION_MAX_PER_CONVERSATION=5

# --- WhatsApp Cloud API (official). Leave empty until configured; UI marks channel unconfigured. ---
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# --- Instagram Messaging API (optional) ---
INSTAGRAM_VERIFY_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_API_VERSION="v21.0"

# --- Messenger API (optional) ---
MESSENGER_VERIFY_TOKEN=""
MESSENGER_APP_SECRET=""
MESSENGER_PAGE_ID=""
MESSENGER_ACCESS_TOKEN=""
MESSENGER_API_VERSION="v21.0"

# --- SMS for order verification (leak 7). Empty = log driver (dev only). ---
SMS_WEBHOOK_URL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Transactional email (password reset). log | smtp | resend ---
# Email provider is used for password resets. "log" writes to console only.
# For an unconfigured provider (smtp without host, resend without key) the
# log driver is used so local dev works with zero credentials.
EMAIL_PROVIDER="log"
EMAIL_FROM=""
# Generic SMTP (e.g. any ESP's SMTP relay)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Resend (https://resend.com)
RESEND_API_KEY=""

# --- Fawry Billing (https://atfawry.com). Unconfigured = billing disabled (no payment links). ---
FAWRY_MERCHANT_CODE=""
FAWRY_SECURE_KEY=""
FAWRY_SANDBOX="true"

# --- Courier (Bosta). Empty api key = no courier integration. ---
BOSTA_API_KEY=""
BOSTA_WEBHOOK_SECRET=""
BOSTA_SANDBOX="true"
SHIPPING_PICKUP_FIRST_NAME="Store"
SHIPPING_PICKUP_LAST_NAME="Pickup"
SHIPPING_PICKUP_PHONE="+201000000000"
SHIPPING_PICKUP_EMAIL=""
SHIPPING_PICKUP_ADDRESS_LINE1="123 Warehouse St"
SHIPPING_PICKUP_CITY="Cairo"
SHIPPING_PICKUP_STATE="Cairo"
SHIPPING_PICKUP_POSTAL_CODE=""

# --- Cron (abandoned-cart nudges). Unset = cron endpoint 403s. ---
CRON_SECRET=""

# --- Worker split (production compose). Unset = web embeds the queue consumer (dev/single-instance). ---
# WORKER_ONLY="1"

# --- Object storage for product images (local | s3). Incomplete s3 falls back to local. ---
STORAGE_PROVIDER="local"
# S3-compatible (e.g. Cloudflare R2). Region "auto" for R2.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Backups (scripts/backup.sh). Scheduling is operator-owned (cron/systemd/K8s CronJob). ---
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# --- Error tracking (optional Sentry-compatible, no SDK). Empty = structured logs only. ---
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""

# --- Local file storage for uploaded images (default ./storage) ---
STORAGE_DIR=""

# --- n8n (optional outbound webhooks) ---
N8N_ORDER_WEBHOOK_URL=""
N8N_GENERIC_WEBHOOK_URL=""

# --- Notifications (console logger by default; plug SMTP/SMS later) ---
NOTIFICATION_DRIVER="console"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_WEBHOOK=300
RATE_LIMIT_MAX_API=300
